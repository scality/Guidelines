{
    "name": "eslint-config-scality",
    "version": "8.3.3",
    "description": "ESLint config for Scality's Node.js coding guidelines",
    "bin": {
        "mdlint": "./bin/mdlint.js",
        "scality-prettier-diff": "./bin/prettier-diff.js"
    },
    "main": "index.js",
    "exports": {
        ".": "./index.js",
        "./base": "./base.js",
        "./prettier.config.cjs": "./prettier.config.cjs",
        "./package.json": "./package.json"
    },
    "scripts": {
        "test": "yarn run --silent lint && yarn run --silent lint_md && node --test 'tests/*.js'",
        "lint": "eslint -c eslint.config.cjs $(git ls-files '*.js')",
        "lint_md": "node bin/mdlint.js $(git ls-files '*.md')",
        "prettier": "prettier"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/scality/Guidelines"
    },
    "dependencies": {
        "globals": "^14.0.0",
        "markdownlint": "0.38.0"
    },
    "peerDependencies": {
        "eslint": "^9",
        "prettier": "^3"
    },
    "peerDependenciesMeta": {
        "prettier": {
            "optional": true
        }
    },
    "devDependencies": {
        "eslint": "^9.39.5",
        "prettier": "^3.9.6"
    },
    "keywords": [
        "eslint",
        "eslintconfig",
        "config",
        "airbnb",
        "scality",
        "javascript",
        "markdown",
        "styleguide"
    ],
    "author": "Giorgio Regni",
    "license": "Apache-2.0",
    "homepage": "https://github.com/scality/Guidelines",
    "engines": {
        "node": ">=22"
    }
}
