{
    "name": "eslint-config-scality",
    "version": "8.2.0",
    "description": "ESLint config for Scality's Node.js coding guidelines",
    "bin": {
        "mdlint": "./bin/mdlint.js"
    },
    "main": "index.js",
    "scripts": {
        "test": "yarn run --silent lint && yarn run --silent lint_md",
        "lint": "eslint -c index.js $(git ls-files '*.js')",
        "lint_md": "node bin/mdlint.js $(git ls-files '*.md')"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/scality/Guidelines"
    },
    "dependencies": {
        "commander": "5.0.0",
        "markdownlint": "^0.19.0"
    },
    "devDependencies": {
        "@babel/eslint-parser": "^7.25.1",
        "@eslint/compat": "^1.1.1",
        "@eslint/eslintrc": "^3.1.0",
        "@eslint/js": "^9.9.1",
        "eslint": "^9.9.1",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-config-airbnb-typescript": "^18.0.0",
        "eslint-plugin-import": "^2.29.1",
        "globals": "^15.9.0"
    },
    "keywords": [
        "eslint",
        "eslintconfig",
        "config",
        "airbnb",
        "scality",
        "javascript",
        "markdown",
        "styleguide"
    ],
    "author": "Giorgio Regni",
    "license": "Apache-2.0",
    "homepage": "https://github.com/scality/Guidelines",
    "engines": {
        "node": ">=16"
    }
}
